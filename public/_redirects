# Stored street-signup Terms & Conditions certificates (legacy long URLs).
/customer-documents/street-terms/* /.netlify/functions/streetTermsDocument?id=:splat 200

# Explicit SPA routes only. Unknown URLs are intentionally left unmatched so
# Netlify serves public/404.html with a real HTTP 404 status instead of the
# homepage with a 200 status (soft 404).
/street-booking /street-booking.html 200
/street-booking/ /street-booking.html 200
/standee/* /index.html 200
/admin /index.html 200
/admin/* /index.html 200
/auth/callback /index.html 200

# Short certificate links, e.g. nibing.uy/ef34gs.
# This is deliberately last so all normal site routes and static files win first.
/:shortcode /.netlify/functions/streetTermsDocument?code=:shortcode 200
